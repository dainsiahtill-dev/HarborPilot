# HarborPilot E2E Test Environment Configuration

# Test Environment
HARBORPILOT_TEST_ENV=test

# Application URL
HARBORPILOT_TEST_BASE_URL=http://localhost:5173

# Workspace Configuration
HARBORPILOT_TEST_WORKSPACE_ROOT=/tmp/harborpilot-test

# AI Service Configuration
HARBORPILOT_MOCK_AI=true
HARBORPILOT_MOCK_RESPONSES_PATH=./fixtures/responses

# Test Configuration
HARBORPILOT_TEST_TIMEOUT=30000
HARBORPILOT_TEST_RETRIES=3

# Logging
HARBORPILOT_LOG_LEVEL=DEBUG

# Browser Configuration
PLAYWRIGHT_BROWSERS_PATH=0
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false

# Reporting
HARBORPILOT_TEST_REPORTS_DIR=./reports
HARBORPILOT_TEST_SCREENSHOTS_DIR=./reports/screenshots

# CI/CD Configuration (for GitHub Actions, etc.)
CI=false
HEADLESS=true
