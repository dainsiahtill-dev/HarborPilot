{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PM Tasks Contract",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "pm_iteration",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this PM run"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "pm_iteration": {
      "type": "integer",
      "minimum": 0
    },
    "focus": {
      "type": "string",
      "description": "Current high-level focus or phase"
    },
    "overall_goal": {
      "type": "string",
      "description": "The overarching goal for this iteration"
    },
    "policy_overrides": {
      "type": "object",
      "description": "Global policy overrides for this run"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policy_overrides": {
            "type": "object"
          }
        }
      }
    }
  }
}
