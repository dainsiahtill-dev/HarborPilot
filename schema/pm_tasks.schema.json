{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PM Tasks Contract",
  "description": "PM -> Director contract. Goal/acceptance fields are immutable during execution; evidence may be appended.",
  "type": "object",
  "examples": [
    {
      "schema_version": 1,
      "run_id": "pm-2026-02-02-0001",
      "timestamp": "2026-02-02T12:00:00Z",
      "pm_iteration": 1,
      "focus": "docs",
      "overall_goal": "Improve AI readiness documentation",
      "tasks": [
        {
          "id": "task-001",
          "title": "Add AI context files",
          "goal": "Create .ai-agent context artifacts for faster agent onboarding",
          "acceptance": [
            ".ai-agent/context.json exists",
            "docs/agent/README.md links to .ai-agent context"
          ],
          "required_evidence": [
            ".ai-agent/context.json",
            "docs/agent/README.md"
          ],
          "target_files": [
            ".ai-agent/context.json",
            "docs/agent/README.md"
          ]
        }
      ]
    }
  ],
  "required": [
    "schema_version",
    "run_id",
    "pm_iteration",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version (fixed)."
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this PM run (links artifacts and events).",
      "examples": ["pm-2026-02-02-0001"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of PM contract emission."
    },
    "pm_iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic PM iteration counter."
    },
    "focus": {
      "type": "string",
      "description": "Current high-level focus or phase.",
      "examples": ["docs", "refactor", "bugfix"]
    },
    "overall_goal": {
      "type": "string",
      "description": "The overarching goal for this iteration.",
      "examples": ["Stabilize director loop error handling"]
    },
    "policy_overrides": {
      "type": "object",
      "description": "Global policy overrides for this run (optional).",
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "description": "Ordered list of tasks in this contract.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable task identifier within the PM contract.",
            "examples": ["task-001"]
          },
          "fingerprint": {
            "type": "string",
            "description": "Fingerprint of immutable task fields (goal/acceptance)."
          },
          "title": {
            "type": "string",
            "description": "Short human-readable task title."
          },
          "goal": {
            "type": "string",
            "description": "Immutable objective for this task. Director must not modify.",
            "examples": ["Refactor io_utils to improve error traceability"]
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Hard constraints or prohibitions for this task."
          },
          "target_files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Expected files to touch or inspect."
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Acceptance criteria strings used by QA. Immutable during execution."
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence paths or artifacts required for validation."
          },
          "policy_overrides": {
            "type": "object",
            "description": "Task-level policy overrides (optional).",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
