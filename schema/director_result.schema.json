{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Director Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "task_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "fail",
        "blocked",
        "unknown"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "failure_code": {
      "type": "string",
      "description": "Categorized failure code (e.g. QA_FAIL, TOOL_TIMEOUT, POLICY_BLOCKED)"
    },
    "task_id": {
      "type": "string"
    },
    "task_fingerprint": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "task_goal": {
      "type": "string"
    },
    "pm_iteration": {
      "type": ["integer", "null"]
    },
    "director_iteration": {
      "type": "integer"
    },
    "tool_rounds": {
      "type": "integer"
    },
    "total_lines_read": {
      "type": "integer"
    },
    "repair_attempts": {
      "type": "integer"
    },
    "patch_risk": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer"
        },
        "factors": {
          "type": "object",
          "properties": {
            "files_changed_count": { "type": "integer" },
            "lines_added": { "type": "integer" },
            "lines_removed": { "type": "integer" },
            "touches_build_system": { "type": "boolean" },
            "touches_security_sensitive": { "type": "boolean" },
            "touches_runtime_entry": { "type": "boolean" },
            "test_coverage_delta": { "type": ["string", "null"] }
          }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "new_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gate": { "type": "string" },
        "threshold": { "type": "integer" }
      }
    },
    "duration": {
      "type": "number"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_effective": {
      "type": "object",
      "description": "The actual policy used during this run"
    },
    "policy_sources": {
      "type": "object",
      "description": "Source tracking for policy values"
    }
  }
}
